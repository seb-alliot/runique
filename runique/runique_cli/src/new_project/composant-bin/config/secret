IP_SERVER=127.0.0.1
PORT=3000

# `dev` or `prod`. Sets how the application behaves: session cookie, startup
# checks, public URL, allowed hosts, template reload, logs. Unset or unknown
# means `prod`.
RUNIQUE_ENV=dev

# Shows the detailed error pages and turns every log channel on. It also works
# with RUNIQUE_ENV=prod to look into a problem on a live site, but every visitor
# then sees those pages, and the logs hold what visitors type in forms
# (passwords excepted): not recommended, turn it off as soon as you're done.
DEBUG=true

# The site's time zone, as region/city (`Europe/Paris`). Dates stored with
# their offset (`timestamp_tz`) are shown in it. Unset or empty, the site is
# in UTC.
TZ=UTC

# Signs the CSRF tokens and the sessions. Generated by `runique new`: keep it
# secret, and set a new one per deployment. Any random string of 32+ characters.
SECRET_KEY=your_secret_key_here

# Database (SQLite by default)
DB_ENGINE=sqlite
# DB_HOST=localhost
# DB_PORT=5432
DB_NAME=data.db
# DB_USER=db-user
# DB_PASSWORD=db-password

DATABASE_URL="sqlite://data.db?mode=rwc"

# Connection pool (PostgreSQL, MySQL). Unset, Runique keeps 2 connections
# open, opens 10 at most and waits 5000 ms to obtain one. A busy site raises
# them; the total of every site must stay under the server's own limit.
# DB_MIN_CONNECTIONS=2
# DB_MAX_CONNECTIONS=10
# DB_ACQUIRE_TIMEOUT=5000

# Uploads: unset, a request is capped at 2 MB. Set it (in MB) to allow
# bigger files: it then caps each file and the whole request (+1 MB).
# RUNIQUE_MAX_UPLOAD_MB=20
