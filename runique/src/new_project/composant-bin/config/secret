IP_SERVER=127.0.0.1
PORT=3000

# `dev` or `prod`. Sets how the application behaves: session cookie, startup
# checks, public URL, allowed hosts, template reload, logs. Unset or unknown
# means `prod`.
RUNIQUE_ENV=dev

# Shows the detailed error pages, and changes nothing else. It also works with
# RUNIQUE_ENV=prod to look into a problem on a live site, but every visitor then
# sees those pages: not recommended, turn it off as soon as you're done.
DEBUG=true

# Signs the CSRF tokens and the sessions. Generated by `runique new`: keep it
# secret, and set a new one per deployment. Any random string of 32+ characters.
SECRET_KEY=your_secret_key_here

# Database (SQLite by default)
DB_ENGINE=sqlite
# DB_HOST=localhost
# DB_PORT=5432
DB_NAME=data.db
# DB_USER=db-user
# DB_PASSWORD=db-password

DATABASE_URL="sqlite://data.db?mode=rwc"

# Uploads: unset, a request is capped at 2 MB. Set it (in MB) to allow
# bigger files: it then caps each file and the whole request (+1 MB).
# RUNIQUE_MAX_UPLOAD_MB=20
