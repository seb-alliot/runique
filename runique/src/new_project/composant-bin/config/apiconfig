[package]
name = "{{PROJECT_NAME}}"
version = "1.0.0"
edition = "2024"
rust-version = "1.94"

# The app and its `migration` crate share one workspace: SeaORM is compiled
# once for both, and the primary key feature below applies to both.
[workspace]
members = ["migration"]

[dependencies]

# Database: sqlite (default), postgres, mysql, mariadb or all-databases.
# Change it here AND in migration/Cargo.toml, along with DB_ENGINE in .env.
#
# Primary keys are i32 by default. Want i64 or UUIDs instead? Add "big-pk" or
# "pk-uuid" to runique's features (pick one, not both):
#   runique = { version = "{{RUNIQUE_VERSION}}", features = ["sqlite", "pk-uuid"] }
# Make that call before your first migration: switching later leaves your code
# and your schema out of sync.
runique = { version = "{{RUNIQUE_VERSION}}", features = ["sqlite"] }

serde = { version = "1", features = ["derive"] }
chrono = "0.4"

# The exact versions runique is built with: change them only with runique.
sea-orm = "{{SEA_ORM_REQ}}"
sea-orm-migration = "{{SEA_ORM_MIGRATION_REQ}}"
